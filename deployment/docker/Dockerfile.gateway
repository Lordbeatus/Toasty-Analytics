FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt httpx

COPY pyproject.toml README.md ./
COPY toastyanalytics/ ./toastyanalytics/
RUN pip install --no-cache-dir .

EXPOSE 8080

CMD ["uvicorn", "toastyanalytics.services.api_gateway:app", "--host", "0.0.0.0", "--port", "8080"]
