# Copy to .env and adjust for your environment.

# Database (SQLite by default; Docker Compose overrides this with PostgreSQL)
TOASTYANALYTICS_DB_URL=sqlite:///toastyanalytics.db
# TOASTYANALYTICS_DB_URL=postgresql://toasty:password123@localhost:5432/toastyanalytics

# Redis (Celery broker and result backend; also the rate-limit backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Authentication
AUTH_ENABLED=true
# Development secret only. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# API keys as key:user_id:roles:scopes, comma separated.
# Roles and scopes are separated by "|"; "*" grants every scope.
TOASTY_API_KEYS=dev-local-key:local-user:admin:*

# Rate limiting (requests per minute, per caller and endpoint)
RATE_LIMIT_ENABLED=true
RATE_LIMIT=60
# 0 means unlimited for callers with the admin role
RATE_LIMIT_ADMIN=0

# Error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
